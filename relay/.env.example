# Before I Tell — relay configuration
# Copy to .env and fill in. NEVER commit the real .env.

# dry  = write mail to outbox/, read replies from inbox-drop/ (no credentials, nothing sent)
# live = actually send email
BIT_RELAY_MODE=dry

# --- SENDING (live mode) ---
# Preferred: Brevo HTTP API. REQUIRED on hosts that block outbound SMTP —
# Render's free tier does, so Gmail SMTP times out there and nothing sends.
# Free: brevo.com → 300 emails/day. Verify a sender address, then Settings →
# SMTP & API → API Keys → create one.
BIT_BREVO_API_KEY=xkeysib-...
# The verified Brevo sender address counsellors see as "From" (can be the Gmail
# below). Defaults to BIT_GMAIL_USER if unset.
BIT_MAIL_FROM=youraccount@gmail.com

# Fallback: Gmail SMTP. Works LOCALLY (SMTP ports open) but NOT on Render free.
# 2-Step Verification ON, then an App Password (Google Account → Security →
# 2-Step Verification → App passwords). Your normal password will NOT work.
# Still used for READING replies (IMAP) even when sending via Brevo.
BIT_GMAIL_USER=youraccount@gmail.com
BIT_GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# --- DEMO ---
# Exact addresses (comma-separated, never domains) the gate accepts in addition
# to school accounts — for filming the send→reply loop against an inbox you own,
# and for boards that block all outside senders. Empty in production.
BIT_DEMO_RECIPIENTS=

# Public origin of THIS relay — used to build the block link inside each email.
BIT_PUBLIC_URL=https://bit-relay.onrender.com

# Where the website is served from. Comma-separated. "*" allows any origin.
BIT_ALLOW_ORIGIN=https://yourname.github.io

# How often to check for counsellor replies, in seconds.
BIT_POLL_SECONDS=20

# Delete threads with no activity for this many days.
BIT_RETAIN_DAYS=90

PORT=8787
